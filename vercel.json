{
  "rewrites": [
    {
      "source": "/api/audit",
      "destination": "/api/audit.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/server.ts"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/server.ts"
    },
    {
      "source": "/robots.txt",
      "destination": "/server.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
